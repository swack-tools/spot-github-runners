# ==============================================================================
# GitHub Credentials
# ==============================================================================

# Renewable GitHub credential with organization runner-management access.
GH_TOKEN=replace-with-renewable-github-token

# Optional GitHub token for <org>/spot-runners-config (falls back to GH_TOKEN).
# Read access covers listing and previews; saving a Runner Patch needs pull-request write access.
SPOT_CONFIG_GH_TOKEN=

# Optional central runner configuration repository, owner/repo (defaults to swack-tools/spot-runners-config).
SPOT_CONFIG_REPO=swack-tools/spot-runners-config


# ==============================================================================
# Cloudflare Worker Edge Control Plane (cloudflare/)
# ==============================================================================

# Target GCP project identifier used by the Worker reconciler.
GCP_PROJECT=replace-with-gcp-project-id

# Primary GitHub organization.
GITHUB_ORG=swack-tools

# JSON service account credentials for Compute Engine REST API (instances.insert, delete, list).
# In production, set with: wrangler secret put GCP_SERVICE_ACCOUNT_KEY
GCP_SERVICE_ACCOUNT_KEY=

# GitHub OAuth 2.0 App credentials for the Web UI Dashboard on https://spot.swacktech.com.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional: set to 1 to enable GitHub Device Flow sign-in on /auth/device/*.
GITHUB_OAUTH_DEVICE_FLOW=

# Optional OAuth scopes (space or comma separated; default: "repo read:org").
GITHUB_OAUTH_SCOPES=repo read:org

# Absolute callback URL for GitHub OAuth.
GITHUB_OAUTH_REDIRECT_URI=https://spot.swacktech.com/auth/github/callback

# Required HMAC secret of at least 32 bytes for signing __Host-spot_session cookies.
# In production, set with: wrangler secret put SESSION_SECRET
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional session lifetime in seconds (60-604800; default: 43200).
DASHBOARD_SESSION_TTL_SECONDS=43200

# Optional bulk sign-out cut-off timestamp (epoch seconds). Sessions issued before it are rejected.
SESSION_NOT_BEFORE=

# Global administrators who sign in without requiring per-target admin permissions.
# Format: login:numeric_id (default: swackhamer:619624).
DASHBOARD_GLOBAL_ADMINS=swackhamer:619624


# ==============================================================================
# Cloudflare Deployment & CLI Settings (Wrangler)
# ==============================================================================

# Cloudflare account ID that owns the Workers KV namespace.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

# Cloudflare Workers KV namespace ID for SPOT_KV binding (dashboard:state).
CLOUDFLARE_KV_NAMESPACE_ID=replace-with-spot-kv-namespace-id

# API token with Workers KV and Worker deploy permissions.
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token


# ==============================================================================
# Pure-Rust Host Agent Settings (host-agent/)
# ==============================================================================

# Path to the real Docker binary for the host-agent docker-wrapper.
GHA_REAL_DOCKER=/usr/bin/docker

# State directory where host-agent docker-wrapper manages socat relays.
GHA_DOCKER_WRAPPER_STATE_DIR=/run/gha-docker-wrapper

# Handshake timeout in seconds for container port-forwarding initialization.
GHA_DOCKER_WRAPPER_HANDSHAKE_TIMEOUT=15.0

# Optional override for runner container ID detection.
GHA_RUNNER_CONTAINER_ID=

# Dedicated builder root directory for sources, targets, and caches.
OXIDEX_BUILD_ROOT=/mnt/runner-data/remote-build

# Dedicated builder lock directory.
OXIDEX_LOCK_ROOT=/run

# Optional flag: set to 1 for unprivileged local test execution of host-launcher.
OXIDEX_ALLOW_UNPRIVILEGED=
