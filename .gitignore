# Allow project source, deployment assets, documentation, and configuration files.
*
!*/
!*.rs
!*.sh
!*.yaml
!*.yml
!*.toml
!*.lock
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!justfile
!Dockerfile
!Dockerfile.*
!.env.example
!.gitignore
!.dockerignore
!AGENTS.md
!CLAUDE.md
!README.md
!PROJECT.md
!TEST_INFRA.md
!TEST_READY.md
!builder/standalone/website-package.json
!builder/standalone/website-package-lock.json
!docs/*.md
!docs/requirements.txt
!docs/images/
!docs/images/*.png
!docs/images/*.svg
!docs/stylesheets/
!docs/stylesheets/*.css
!docs/javascripts/
!docs/javascripts/*.js
!host-agent/**
!cloudflare/Cargo.toml
!cloudflare/Cargo.lock
!cloudflare/wrangler.toml
!cloudflare/src/**
!cloudflare/tests/**
!cloudflare/build/worker/shim.mjs
!tools/edge_dashboard_probe.js
!tests/fixtures/*.json

# Secrets, generated files, and local-only artifacts
.env
.DS_Store
*.log
.firecrawl/
/docs/superpowers/
/site/

# Rust build artifacts and target directories
target/
**/target/
host-agent/target/
cloudflare/target/
cloudflare/.wrangler/
.wrangler/
*.rs.bk
*.pdb
Cargo.lock.bak

# Documentation lint configuration; downloaded styles stay local.
!.vale.ini
.vale/styles/
