    {
      "id": "v3_nntmux_multisection_manifest",
      "description": "Complex manifest with custom sysctls, multiline scripts, files, mounts, and qualify_command",
      "input_manifest": {
        "schema": "spot-runner-patch-v1",
        "repository": "xbmc4lyfe/newznab-tmux",
        "hardware": {
          "arch": "x86_64",
          "isa": [
            "avx512-vbmi2"
          ],
          "extra_labels": [
            "avx512-vbmi2",
            "nntmux-simd"
          ],
          "min_vcpu": 16,
          "min_ram_gib": 64,
          "qualify_command": "grep -q avx512_vbmi2 /proc/cpuinfo\n"
        },
        "host": {
          "apt_packages": [
            "linux-perf"
          ],
          "sysctl": {
            "net.core.rmem_max": 134217728,
            "net.core.wmem_max": 134217728,
            "vm.max_map_count": 262144
          },
          "boot_mkdirs": [
            "/mnt/runner-data/nntmux-cache"
          ],
          "files": [
            {
              "path": "/etc/security/limits.d/99-nntmux.conf",
              "mode": "0644",
              "owner": "root:root",
              "content": "* soft nofile 1048576\n* hard nofile 1048576\n"
            }
          ],
          "boot_script": "chown 1001:1001 /mnt/runner-data/nntmux-cache\n"
        },
        "container": {
          "apt_packages": [
            "php-cli",
            "php-ffi",
            "composer"
          ],
          "sysctl": {
            "net.ipv4.tcp_rmem": "4096 87380 67108864",
            "net.ipv4.tcp_wmem": "4096 65536 67108864"
          },
          "mounts": [
            {
              "source": "/mnt/runner-data/nntmux-cache",
              "target": "/work/.nntmux-cache",
              "read_only": false
            }
          ],
          "files": [
            {
              "path": "/etc/php-ffi-runner.ini",
              "mode": "0644",
              "content": "ffi.enable=true\nmemory_limit=1G\n"
            }
          ],
          "dockerfile_run": "php -v && composer --version\n"
        }
      },
      "raw_dict_sha256": "0c0a44a79d0365ef83c9d235581022fe875240f737cac80ce9ca7fd17134a1ce",
